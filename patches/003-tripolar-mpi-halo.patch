+def _fold_tripolar_north(
+    field: jax.Array,
+    halo: int,
+    fold,
+    *,
+    is_vector_v: bool = False,
+    is_vector_u: bool = False,
+) -> jax.Array:
+    """Tripolar fold at the north boundary using FoldDescriptor.perm_T.
+
+    Returns shape (halo, n_lon[, nlev]) — the north halo rows.
+
+    For scalar fields: take the last `halo` rows in reverse order,
+    permute columns by fold.perm_T.
+    For vector v fields: permute by fold.perm_v, multiply by
+    fold.vector_sign_v.
+    For vector u fields: permute by fold.perm_T, multiply by
+    fold.vector_sign_u.
+    """
+    src = field[-halo:][::-1]
+
+    if is_vector_v:
+        perm = fold.perm_v
+        sign = fold.vector_sign_v
+    elif is_vector_u:
+        perm = fold.perm_T
+        sign = fold.vector_sign_u
+    else:
+        perm = fold.perm_T
+        sign = 1.0
+
+    n_lon = len(perm)
+    if field.shape[1] == n_lon + 1:
+        core = sign * src[:, :n_lon][:, perm]
+        folded = jnp.concatenate([core, core[:, 0:1]], axis=1)
+    else:
+        folded = sign * src[:, perm]
+
+    return folded
+
