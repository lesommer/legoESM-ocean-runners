+def scatter_state_latlon_cgrid_ocean(state, layout: LatLonBandLayout):
+    """Extract the rank-local band from a global C-grid ocean state.
+
+    Each rank reads its own slice of the global arrays; we do not call
+    MPI here (callers either broadcast a global state from rank 0 or
+    each rank constructs the global initial state locally and slices).
+
+    The C-grid v-field at lat interfaces has one extra row globally
+    (shape ``(n_lat+1, n_lon, ...)``); we give each rank rows
+    ``[lat_start, lat_end+1)`` so neighbouring ranks duplicate the
+    boundary row.  The v_mask field follows the same convention.
+    """
+    s, e = layout.lat_start, layout.lat_end
+
+    return state._replace(
+        u=state.u.replace(data=state.u.data[s:e]),
+        v=state.v.replace(data=state.v.data[s:e + 1]),
+        T=state.T.replace(data=state.T.data[s:e]),
+        S=state.S.replace(data=state.S.data[s:e]),
+        eta=state.eta.replace(data=state.eta.data[s:e]),
+        H_bathy=state.H_bathy.replace(data=state.H_bathy.data[s:e]),
+        land_mask=state.land_mask.replace(data=state.land_mask.data[s:e]),
+        u_mask=state.u_mask.replace(data=state.u_mask.data[s:e]),
+        v_mask=state.v_mask.replace(data=state.v_mask.data[s:e + 1]),
+        w=state.w.replace(data=state.w.data[s:e]) if state.w is not None else state.w,
+    )
+
+
+def gather_state_latlon_cgrid_ocean(local_state, layout: LatLonBandLayout):
+    """Gather rank-local C-grid ocean state onto rank 0; returns ``None`` elsewhere."""
+    T_global = gather_field_latlon(local_state.T.data, layout)
+    S_global = gather_field_latlon(local_state.S.data, layout)
+    u_global = gather_field_latlon(local_state.u.data, layout)
+    v_global = gather_field_latlon(local_state.v.data, layout, is_v_face=True)
+    eta_global = gather_field_latlon(local_state.eta.data, layout)
+    H_bathy_global = gather_field_latlon(local_state.H_bathy.data, layout)
+    land_mask_global = gather_field_latlon(local_state.land_mask.data, layout)
+    u_mask_global = gather_field_latlon(local_state.u_mask.data, layout)
+    v_mask_global = gather_field_latlon(local_state.v_mask.data, layout, is_v_face=True)
+    w_global = gather_field_latlon(local_state.w.data, layout) if local_state.w is not None else None
+
+    if layout.rank == 0:
+        updates = dict(
+            u=local_state.u.replace(data=u_global),
+            v=local_state.v.replace(data=v_global),
+            T=local_state.T.replace(data=T_global),
+            S=local_state.S.replace(data=S_global),
+            eta=local_state.eta.replace(data=eta_global),
+            H_bathy=local_state.H_bathy.replace(data=H_bathy_global),
+            land_mask=local_state.land_mask.replace(data=land_mask_global),
+            u_mask=local_state.u_mask.replace(data=u_mask_global),
+            v_mask=local_state.v_mask.replace(data=v_mask_global),
+            w=local_state.w.replace(data=w_global) if local_state.w is not None else local_state.w,
+        )
+        return local_state._replace(**updates)
+    return None
