+def init_ocean_from_woce(state, ic_t_path, ic_s_path, land_mask):
+    """Read WOCE/EN4 initial conditions from NetCDF and set T/S in the state.
+
+    The WOCE files use the same eORCA1 grid as the mesh file, so they can be
+    directly assigned.  Reads ``contemp`` (temperature) and ``presalt``
+    (salinity) variables, masks land points, and replaces state.T.data and
+    state.S.data.
+    """
+    import xarray as xr
+    ds_t = xr.open_dataset(ic_t_path)
+    ds_s = xr.open_dataset(ic_s_path)
+    T_data = np.asarray(ds_t["contemp"].values, dtype=np.float64)
+    S_data = np.asarray(ds_s["presalt"].values, dtype=np.float64)
+    m2 = np.asarray(land_mask) > 0.5
+    m3 = m2[..., None]
+    T_data = np.where(m3, T_data, 0.0)
+    S_data = np.where(m3, S_data, 0.0)
+    state = state._replace(
+        T=state.T.replace(data=jnp.asarray(T_data)),
+        S=state.S.replace(data=jnp.asarray(S_data)),
+    )
+    print(f"[setup] T/S initialised from WOCE/EN4 "
+          f"({Path(ic_t_path).name}, {Path(ic_s_path).name})")
+    return state
+
+
