+        state = init_from_nemo_ic(
+            geom, z_coord, args.ic_t, args.ic_s,
+            land_mask_2d=land_mask_2d, H_bathy_2d=H_bathy_2d,
+            month=args.ic_month,
+        )
+    print(f"  Initial state: T shape={state.T.data.shape}, "
+          f"u shape={state.u.data.shape}")
+
+    _mask = np.asarray(state.land_mask.data)
+    _T = np.asarray(state.T.data)
+    _S = np.asarray(state.S.data)
+    _wet = _mask > 0.5
+    _is_active = np.asarray(z_coord.is_active, dtype=bool)
+    _T_ocean = _T[_is_active]
+    _S_ocean = _S[_is_active]
+    print(f"  IC check: T range [{_T_ocean.min():.3f}, {_T_ocean.max():.3f}], "
