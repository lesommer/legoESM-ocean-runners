+#!/usr/bin/env python
+"""Tripolar eORCA1 OMIP run with CORE-II Normal Year Forcing.
+
+NEMO-identical configuration using domain_cfg.nc for grid + partial cells,
+WOCE/EN4 initial conditions, integrated surface forcing with Jerlov SW
+penetration, SSS restoring, and Dai-Trenberth runoff.
+
+Produces NEMO-compatible output files (grid_T/U/V) for direct comparison
+with the NEMO ORCA1 reference run.
+
+Usage:
+    JAX_ENABLE_X64=1 python scripts/run_omip_tripole.py \
+        --days 365 --dt 3600 --nlev 75 \
+        --domain-cfg data/grids/domain_cfg.nc \
+        --fold-convention n_lon-1-i \
+        --ic-t data/ic/woce_temp_monthly_init_4p2.nc \
+        --ic-s data/ic/woce_salt_monthly_init_4p2.nc \
+        --sss-target data/sss/sss_climatology_for_restoring.nc \
+        --core2-cache data/core2_nyf \
+        --water-type II \
+        --runoff \
+        --output results/omip_tripole \
+        --exp-name ORCA1_LEGO
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time as _time
+from pathlib import Path
+
+sys.stdout.reconfigure(line_buffering=True)
+
+_PROJECT_ROOT = str(Path(__file__).resolve().parents[1])
+if _PROJECT_ROOT not in sys.path:
+    sys.path.insert(0, _PROJECT_ROOT)
+
+import jax
+jax.config.update("jax_enable_x64", True)
+
+import jax.numpy as jnp
+import numpy as np
+
+from legoesm.core.precision import PrecisionPolicy, set_policy
+set_policy(PrecisionPolicy.fp64())
+
+
+# ---------------------------------------------------------------------------
+# CLI
+# ---------------------------------------------------------------------------
+
+def parse_args():
+    p = argparse.ArgumentParser(
+        description="Tripolar eORCA1 OMIP with CORE-II Normal Year Forcing",
+    )
+    # Time
+    p.add_argument("--days", type=float, default=365.0,
+                   help="Simulation length [days] (default 365)")
+    p.add_argument("--dt", type=float, default=1200.0,
+                   help="Timestep [s] (default 1200)")
+    p.add_argument("--nlev", type=int, default=75,
+                   help="Number of vertical levels (default 75)")
+    # Grid
+    p.add_argument("--domain-cfg", type=str, required=True,
+                   help="Path to NEMO domain_cfg.nc (grid + bathymetry + partial cells)")
+    p.add_argument("--fold-convention", type=str, default="n_lon-1-i",
+                   choices=["auto", "n_lon-1-i", "(n_lon-i)%n_lon"],
+                   help="Tripole fold index convention (default: n_lon-1-i for eORCA1)")
+    # Initial conditions
+    p.add_argument("--ic-t", type=str, default="",
+                   help="Path to NEMO WOCE temperature IC NetCDF (contemp)")
+    p.add_argument("--ic-s", type=str, default="",
+                   help="Path to NEMO WOCE salinity IC NetCDF (presalt)")
+    p.add_argument("--ic-month", type=int, default=0,
+                   help="Month index (0-11) for ICs (default 0 = January)")
+    p.add_argument("--idealized-ic", action="store_true",
+                   help="Use idealized exponentially-stratified ICs (in hydrostatic balance, avoids cold-start blowup)")
+    # Forcing
+    p.add_argument("--core2-cache", type=str, default="",
+                   help="Path to CORE-II NYF cache directory")
+    p.add_argument("--synthetic-forcing", action="store_true",
+                   help="Use synthetic forcing (for testing without CORE2 data)")
+    p.add_argument("--forcing-scale", type=float, default=1.0,
+                   help="Scale factor for surface forcing amplitude (default 1.0; use <1 for cold-start spinup)")
+    # Physics
+    p.add_argument("--water-type", type=str, default="II",
+                   choices=["I", "II", "III", "IA", "IB", "III", "none"],
+                   help="Jerlov water type for SW penetration (default II)")
+    p.add_argument("--sss-target", type=str, default="",
+                   help="Path to NEMO SSS climatology for restoring (presalt)")
+    p.add_argument("--runoff", action="store_true",
+                   help="Enable Dai-Trenberth river runoff")
+    p.add_argument("--smag-cfl-safety", type=float, default=0.125,
+                   help="Smagorinsky CFL safety cap (0=disabled, default 0.125)")
+    p.add_argument("--no-adaptive-vertadv", action="store_true",
+                   help="Disable adaptive-implicit vertical momentum advection")
+    p.add_argument("--no-gm-redi", action="store_true",
+                   help="Disable GM/Redi isopycnal mixing (useful for cold-start spinup)")
+    # Output
+    p.add_argument("--output", type=str, default="results/omip_tripole",
+                   help="Output directory")
+    p.add_argument("--checkpoint-days", type=float, default=30.0,
+                   help="Save checkpoint every N days (default 30)")
+    p.add_argument("--exp-name", type=str, default="ORCA1_LEGO",
+                   help="Experiment name for output files (default ORCA1_LEGO)")
+    p.add_argument("--restart", type=str, default="",
+                   help="Path to restart .npz file to resume from")
+    return p.parse_args()
