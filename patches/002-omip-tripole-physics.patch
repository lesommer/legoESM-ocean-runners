+        implicit_vertical_mixing=True,
+        smag_cfl_safety=args.smag_cfl_safety,
+        adaptive_implicit_vertadv=not args.no_adaptive_vertadv,
+        tracer_advection="tvd",
+        bottom_drag_r=1e-3,
+        bottom_drag_bbl_thickness=100.0,
