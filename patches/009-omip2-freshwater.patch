+def test_omip2_freshwater_flag_applies_p_minus_e(grid_type, res):
+    """``apply_freshwater=True`` routes P - E through the in-core
+    ``model.step(freshwater=...)`` channel: bit-identical to the manual
+    sf+fw step, and it moves S vs the momentum+heat-only default (the
+    Tsujino 2020 water cycle; the helper default stays False so
+    run_bryan_thc / run_centennial_spinup keep their behavior)."""
+    m = _omip2()
+    from legoesm.ocean.coupler import (
+        compute_omip2_freshwater_forcing, compute_omip2_surface_forcing)
+    state, grid, z, model = m._build_state(grid_type, res, nlev=6,
+                                           scripts_dir=_MATRIX)
+    forcing = _east_wind()   # precip = 0, evap > 0 -> net freshwater loss
+    fw = compute_omip2_freshwater_forcing(
+        state, forcing=forcing, idx_t=0, grid=grid, grid_type=grid_type)
+    sf = compute_omip2_surface_forcing(
+        state, forcing=forcing, idx_t=0, grid=grid, grid_type=grid_type)
+    got = m.step_with_omip2_forcing(
+        model, state, forcing=forcing, idx_t=0, grid=grid,
+        grid_type=grid_type, dt=_DT, apply_freshwater=True)
+    want = model.step(state, _DT, surface_forcing=sf, freshwater=fw)
+    np.testing.assert_array_equal(np.asarray(got.S.data),
+                                  np.asarray(want.S.data))
+    legacy = m.step_with_omip2_forcing(
+        model, state, forcing=forcing, idx_t=0, grid=grid,
+        grid_type=grid_type, dt=_DT)
+    assert float(np.abs(np.asarray(got.S.data)
+                        - np.asarray(legacy.S.data)).max()) > 0.0
