+def find_latest_restart(output_dir):
+    """Latest ``restart_year_*.npz`` in ``output_dir`` as (path, year).
+
+    The year comes from the filename (the driver writes one restart per
+    model year, ``restart_year_%04d.npz``), so a walltime-chunked run can
+    pick up where the previous segment stopped.
+    """
+    best = None
+    for p in Path(output_dir).glob("restart_year_*.npz"):
+        m = re.search(r"restart_year_(\d+)\.npz$", p.name)
+        if m is not None:
+            year = int(m.group(1))
+            if best is None or year > best[1]:
+                best = (p, year)
+    return best
+
