+def test_find_latest_restart_parses_year_numbering(tmp_path):
+    """``find_latest_restart`` returns the highest-numbered yearly restart."""
+    m = _omip2()
+    assert m.find_latest_restart(tmp_path) is None
+    for name in ("restart_year_0001.npz", "restart_year_0012.npz",
+                 "restart_year_0007.npz"):
+        (tmp_path / name).touch()
+    path, year = m.find_latest_restart(tmp_path)
+    assert year == 12 and path.name == "restart_year_0012.npz"
+
+
+def test_omip2_auto_resume_continues_year_numbering(tmp_path, monkeypatch):
+    """A second segment into the same --output auto-resumes from the latest
+    yearly restart: the year counter, the forcing year and the summary's
+    yearly chain continue (walltime-chunked 30-yr production; dt = 1 yr per
+    step keeps each segment at one step on the tiny grid)."""
+    m = _omip2()
+    argv = ["run_omip2.py", "--dt", "31536000", "--grid", "latlon",
+            "--resolution", "9x18", "--allow-synthetic"]
+    monkeypatch.setattr(sys, "argv", argv + ["--years", "1",
+                                             "--output", str(tmp_path)])
+    assert m.main() == 0
+    first = json.loads((tmp_path / "summary.json").read_text())
+    assert first["resumed_from_year"] == 0 and len(first["yearly"]) == 1
+
+    monkeypatch.setattr(sys, "argv", argv + ["--years", "3",
+                                             "--output", str(tmp_path)])
+    assert m.main() == 0
+    second = json.loads((tmp_path / "summary.json").read_text())
+    assert second["resumed_from_year"] == 1
+    assert [row["year"] for row in second["yearly"]] == [1, 2, 3]
+    assert (tmp_path / "restart_year_0003.npz").exists()
+    assert second["wall_seconds_cumulative"] >= second["wall_seconds"]
