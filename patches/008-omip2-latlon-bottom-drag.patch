+def test_latlon_bottom_drag_is_forwarded():
+    """run_omip2 / run_bryan_thc pass ``bottom_drag_r=1e-3`` (wind-input
+    balance); the modular latlon setup must forward it like the mpas branch
+    and the monolithic runner always did — a silent drop leaves the 30-yr
+    production lane drag-free."""
+    m = _omip2()
+    state, grid, z, model = m._build_state("latlon", "18x36", nlev=6,
+                                           scripts_dir=_MATRIX)
+    assert float(model.config.bottom_drag.bottom_drag_r) == 1.0e-3
+
